{
    "compilerOptions": {
        "jsx": "react",
        "noEmit": true,
        "target": "ES6",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "moduleResolution": "node",
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["../globals.d.ts", "./**/*", "./common/**/*"]
}
